# These belong ONLY on the hosted EBS, never in the companion or extension ZIP.
TWITCH_EXTENSION_CLIENT_ID=
# Optional: defaults to the broadcaster's numeric channel ID for channel PubSub.
TWITCH_EXTENSION_OWNER_ID=
# Extension secret from the Twitch developer console, base64 encoded.
TWITCH_EXTENSION_SECRET=
HOST=127.0.0.1
PORT=8788
# Enable only for localhost development; use false behind production HTTPS.
ALLOW_LOCAL_TESTING=false
EBS_DATA_PATH=.runtime/ebs-credentials.json
